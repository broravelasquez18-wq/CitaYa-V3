  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal: placa noche con texto blanco.",
      "html": "<button class=\"ds-btn-primary\">Buscar y solicitar historia <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:10px 18px;border:1.5px solid transparent;border-radius:var(--radius,6px);background:var(--night,#0f1b2d);color:#fff;font-family:var(--sans);font-size:1rem;font-weight:650;line-height:1.2;cursor:pointer;transition:background-color .15s,transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:var(--night-3,#243954)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--focus,#24569e);outline-offset:2px}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción alternativa: blanco con borde fuerte.",
      "html": "<button class=\"ds-btn-secondary\">Hacer otra solicitud</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:10px 18px;border:1.5px solid var(--line-strong,#b4c0ce);border-radius:var(--radius,6px);background:var(--surface,#fff);color:var(--ink,#0f1b2d);font-family:var(--sans);font-size:1rem;font-weight:650;line-height:1.2;cursor:pointer;transition:border-color .15s}.ds-btn-secondary:hover{border-color:var(--night,#0f1b2d)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:3px solid var(--focus,#24569e);outline-offset:2px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo de 48px con etiqueta en negrita; documento en mono.",
      "html": "<label class=\"ds-label\">Número de documento<input class=\"ds-input\" placeholder=\"Sin puntos ni espacios\"></label>",
      "css": ".ds-label{display:block;color:var(--ink-2,#2f3f54);font-family:var(--sans);font-size:.875rem;font-weight:700}.ds-input{display:block;width:100%;height:48px;margin-top:6px;padding:0 12px;background:var(--surface,#fff);border:1.5px solid var(--line-strong,#b4c0ce);border-radius:var(--radius,6px);color:var(--ink,#0f1b2d);font-family:var(--mono);font-variant-numeric:tabular-nums;font-size:1rem;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{font-family:var(--sans);color:#76838f}.ds-input:hover{border-color:var(--muted,#536274)}.ds-input:focus{outline:none;border-color:var(--night,#0f1b2d);box-shadow:0 0 0 3px var(--info-soft,#e7eef9),0 0 0 4px var(--info,#24569e)}"
    },
    {
      "name": "Pastillas de estado",
      "kind": "chip",
      "refersTo": "pill-live",
      "description": "Color + ícono + texto: en curso, listo, detenido.",
      "html": "<span class=\"ds-pill ds-live\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3.2 2\"/></svg>En cola</span> <span class=\"ds-pill ds-ok\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Enviado</span> <span class=\"ds-pill ds-stop\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3.5 2.8 19.5h18.4Z\"/><path d=\"M12 10v4.5M12 17.2h.01\"/></svg>Fallido</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:999px;border:1px solid var(--line,#d5dce5);font-family:var(--sans);font-size:.8125rem;font-weight:700;line-height:1.4;white-space:nowrap}.ds-live{background:var(--amber-soft,#fdf1d6);border-color:#efd08c;color:var(--amber-ink,#6b4100)}.ds-ok{background:var(--ok-soft,#e3f2e9);border-color:var(--ok-line,#b5dcc4);color:var(--ok,#1b7348)}.ds-stop{background:var(--stop-soft,#fbe8e6);border-color:var(--stop-line,#efc2bd);color:var(--stop,#b3302a)}"
    },
    {
      "name": "Tarjeta",
      "kind": "card",
      "refersTo": "card",
      "description": "Superficie blanca con filete de 1px, sin sombra.",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-head\"><h2>Solicita tu historia clínica</h2><p>Escribe los datos tal como aparecen en tu documento.</p></div><p>Contenido</p></section>",
      "css": ".ds-card{background:var(--surface,#fff);border:1px solid var(--line,#d5dce5);border-radius:var(--radius-lg,10px);padding:24px;font-family:var(--sans);color:var(--ink,#0f1b2d)}.ds-card-head{padding-bottom:16px;margin-bottom:24px;border-bottom:1px solid var(--line,#d5dce5)}.ds-card-head h2{font-size:1.375rem;font-weight:650;letter-spacing:-.015em;margin:0 0 4px}.ds-card-head p{margin:0;color:var(--muted,#536274);font-size:.875rem}"
    },
    {
      "name": "Rail de la consola",
      "kind": "nav",
      "refersTo": "rail-item",
      "description": "Navegación interna noche con contador ámbar y barra blanca de selección.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-rail-item ds-selected\" href=\"#\"><span>Solicitudes</span><span class=\"ds-count\">3</span></a><a class=\"ds-rail-item\" href=\"#\"><span>Reportes de error</span></a><a class=\"ds-rail-item\" href=\"#\"><span>Mi avance</span></a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:248px;padding:16px 12px;background:var(--night,#0f1b2d);font-family:var(--sans)}.ds-rail-item{position:relative;display:flex;align-items:center;gap:12px;min-height:42px;padding:0 12px;border-radius:var(--radius,6px);color:var(--night-muted,#a9b8cc);font-size:.875rem;font-weight:600;text-decoration:none}.ds-rail-item span:first-child{flex:1}.ds-rail-item:hover{background:var(--night-2,#18293f);color:#fff}.ds-rail-item:focus-visible{outline:3px solid #fff;outline-offset:2px}.ds-selected{background:var(--night-3,#243954);color:#fff}.ds-selected::before{content:\"\";position:absolute;left:-12px;top:8px;bottom:8px;width:3px;border-radius:0 3px 3px 0;background:#fff}.ds-count{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:var(--amber,#f2a516);color:var(--night,#0f1b2d);font-family:var(--mono);font-size:.8125rem;font-weight:700;line-height:1}"
    },
    {
      "name": "Placa del radicado llamado",
      "kind": "custom",
      "refersTo": "call-plate",
      "description": "Firma: radicado en mono grande sobre noche, estado en pastilla de color; ámbar y barrido solo si está en curso.",
      "html": "<section class=\"ds-plate\"><div class=\"ds-num\"><span class=\"ds-label\">Radicado</span><strong class=\"ds-ref\">HC-261013-4F9A</strong></div><div class=\"ds-state\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3.2 2\"/></svg><h2>En cola de envío</h2></div><span class=\"ds-scan\" aria-hidden=\"true\"></span></section>",
      "css": ".ds-plate{position:relative;overflow:hidden;display:grid;gap:16px;padding:24px;background:var(--night,#0f1b2d);color:var(--night-ink,#eef2f7);border-radius:var(--radius-lg,10px);font-family:var(--sans)}.ds-num{display:flex;flex-direction:column;gap:2px}.ds-label{font-size:.8125rem;font-weight:700;color:var(--night-muted,#a9b8cc);letter-spacing:.06em;text-transform:uppercase}.ds-ref{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:700;font-size:clamp(1.5rem,1rem + 2.4vw,2.5rem);line-height:1.05;color:#fff}.ds-state{display:flex;align-items:center;gap:12px;justify-self:start;padding:8px 16px;border-radius:var(--radius,6px);background:var(--amber,#f2a516);color:var(--night,#0f1b2d)}.ds-state h2{margin:0;font-size:1.125rem;font-weight:650;color:var(--night,#0f1b2d)}.ds-scan{position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,transparent 0 35%,var(--amber,#f2a516) 35% 65%,transparent 65% 100%);background-size:250% 100%;animation:ds-scan 2.4s cubic-bezier(.16,1,.3,1) infinite}@keyframes ds-scan{from{background-position:100% 0}to{background-position:0 0}}@media(prefers-reduced-motion:reduce){.ds-scan{animation:none;background:var(--amber,#f2a516)}}"
    },
    {
      "name": "Barra de participación",
      "kind": "custom",
      "refersTo": "share-bar",
      "description": "Fila del análisis por especialidad: barra SVG en tinta noche por atributos, ordenada de mayor a menor.",
      "html": "<table class=\"ds-share\"><tr><th>Ortopedia y traumatología</th><td class=\"ds-n\">66,7%</td><td class=\"ds-bar\"><svg width=\"100%\" height=\"10\" aria-hidden=\"true\"><rect class=\"ds-track\" width=\"100%\" height=\"10\"/><rect class=\"ds-fill\" width=\"100%\" height=\"10\"/></svg></td></tr><tr><th>Medicina general</th><td class=\"ds-n\">33,3%</td><td class=\"ds-bar\"><svg width=\"100%\" height=\"10\" aria-hidden=\"true\"><rect class=\"ds-track\" width=\"100%\" height=\"10\"/><rect class=\"ds-fill\" width=\"50%\" height=\"10\"/></svg></td></tr></table>",
      "css": ".ds-share{width:100%;border-collapse:collapse;font-family:var(--sans);font-size:.875rem}.ds-share th{text-align:left;font-weight:600;color:var(--ink,#0f1b2d);padding:12px;border-bottom:1px solid var(--line,#d5dce5)}.ds-share td{padding:12px;border-bottom:1px solid var(--line,#d5dce5)}.ds-n{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:700}.ds-bar{width:38%}.ds-bar svg{display:block}.ds-track{fill:var(--surface-2,#f5f7f9)}.ds-fill{fill:var(--night,#0f1b2d)}"
